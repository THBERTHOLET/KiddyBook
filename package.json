{
  "name": "kiddybooks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "demo-assets": "node scripts/make-demo-assets.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
